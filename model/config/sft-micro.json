{
  "name": "micro-char-sft",
  "seed": 1337,
  "tokenizer": "char",
  "vocab_path": "data/pretraining/vocab.json",
  "train_data": "data/instruction/train.bin",
  "val_data": "data/instruction/val.bin",
  "block_size": 128,
  "n_layer": 2,
  "n_head": 4,
  "n_embd": 128,
  "dropout": 0.1,
  "batch_size": 16,
  "gradient_accumulation": 1,
  "learning_rate": 0.00005,
  "min_learning_rate": 0.000005,
  "warmup_steps": 10,
  "max_steps": 300,
  "eval_interval": 25,
  "eval_batches": 20,
  "checkpoint_interval": 50,
  "weight_decay": 0.05,
  "grad_clip": 1.0,
  "device": "auto"
}
