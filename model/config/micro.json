{
  "name": "micro-char",
  "seed": 1337,
  "tokenizer": "char",
  "vocab_path": "data/pretraining/vocab.json",
  "train_data": "data/pretraining/train.bin",
  "val_data": "data/pretraining/val.bin",
  "block_size": 128,
  "n_layer": 2,
  "n_head": 4,
  "n_embd": 128,
  "dropout": 0.1,
  "batch_size": 16,
  "gradient_accumulation": 1,
  "learning_rate": 0.0003,
  "min_learning_rate": 0.00003,
  "warmup_steps": 50,
  "max_steps": 1000,
  "eval_interval": 50,
  "eval_batches": 20,
  "checkpoint_interval": 100,
  "weight_decay": 0.1,
  "grad_clip": 1.0,
  "device": "auto"
}
